{
  "info": {
    "name": "在线商店 API",
    "description": "在线商店管理系统API测试集合",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "认证管理",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (responseCode.code === 200) {",
                  "    var response = pm.response.json();",
                  "    pm.globals.set('authToken', response.token);",
                  "    pm.test('登录成功', function () {",
                  "        pm.expect(response.token).to.not.be.undefined;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "用户登出",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "商品管理",
      "item": [
        {
          "name": "创建商品",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"category\": \"电子产品\",\n  \"price\": 6999.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "response": []
        },
        {
          "name": "查询商品列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?pageNum=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "name",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "根据ID查询商品",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          },
          "response": []
        },
        {
          "name": "更新商品",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"price\": 7999.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          },
          "response": []
        },
        {
          "name": "删除商品",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          },
          "response": []
        },
        {
          "name": "获取商品分类",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "categories"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "库存管理",
      "item": [
        {
          "name": "查询库存列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory?pageNum=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory"],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "lowStockOnly",
                  "value": "false",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "根据商品ID查询库存",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/product/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "product", "1"]
            }
          },
          "response": []
        },
        {
          "name": "入库操作",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 100,\n  \"reason\": \"采购入库\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/stock-in",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "stock-in"]
            }
          },
          "response": []
        },
        {
          "name": "出库操作",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 30,\n  \"reason\": \"销售出库\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/stock-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "stock-out"]
            }
          },
          "response": []
        },
        {
          "name": "库存调整",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"newStock\": 200,\n  \"reason\": \"盘点调整\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/adjust",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "adjust"]
            }
          },
          "response": []
        },
        {
          "name": "更新库存设置",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/1/settings?minStock=20&maxStock=2000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "1", "settings"],
              "query": [
                {
                  "key": "minStock",
                  "value": "20"
                },
                {
                  "key": "maxStock",
                  "value": "2000"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "查询库存变更记录",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/records?pageNum=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "records"],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "productId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "operationType",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "获取库存统计",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "stats"]
            }
          },
          "response": []
        },
        {
          "name": "检查库存充足性",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/check?productId=1&quantity=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "check"],
              "query": [
                {
                  "key": "productId",
                  "value": "1"
                },
                {
                  "key": "quantity",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "获取低库存商品数量",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/low-stock/count",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "low-stock", "count"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "用户管理",
      "item": [
        {
          "name": "查询用户列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Token",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?pageNum=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}